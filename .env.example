# Names only. Real values go to `.env` (ignored by git) on the workstation and to
# /opt/ruslan-bot/.env on the server — rule no-secrets-in-git.

# The only thing the owner pastes (runbooks/discord-app-setup.md §2).
DISCORD_TOKEN=

# Optional. Empty = derived from the token.
DISCORD_CLIENT_ID=
# Optional. Empty = the one server the bot is in; set it only if the bot is in several.
DISCORD_GUILD_ID=

# Workstation: the `postgres` service of docker-compose.dev.yml.
# Server: not needed — deploy/docker-compose.yml builds it from POSTGRES_PASSWORD.
DATABASE_URL=postgresql://kiber:kiber@localhost:5432/kiberpride
# db tests: the `postgres-test` service (docker-compose.dev.yml) or the CI service container.
TEST_DATABASE_URL=postgresql://kiber:kiber@localhost:5433/kiberpride_test

# Server only: the database password (a long random string generated by the agent).
POSTGRES_PASSWORD=

LOG_LEVEL=info
# development (pretty logs, 🧪 test players) | production | test. Unset = production.
NODE_ENV=development
# Baked into the image by deploy/compose.sh; locally empty = the git short sha.
APP_VERSION=
