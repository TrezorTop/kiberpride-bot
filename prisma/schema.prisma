// First-release schema — decision 003 (product/decisions/003-first-release-schema.md).
// Match state machine — decision 004. One deployment serves one guild: no guildId columns.
//
// Constraints Prisma cannot express are hand-written SQL in the migrations and named here
// next to their model. Every one of them must have a db test that makes it fire.

generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  moduleFormat           = "esm"
  importFileExtension    = "js"
  generatedFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

// ─── Economy ────────────────────────────────────────────────────────────────

/// A Discord member known to the bot. Created on first contact by upsert.
/// Raw SQL: CHECK "User_balance_nonnegative" (balance >= 0).
model User {
  id        String   @id // Discord snowflake
  balance   Int      @default(0) // cached; only economy.move writes it (003 §4)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  transactions KpTransaction[]
  purchases    Purchase[]
  participants Participant[]
}

enum TxKind {
  MATCH_PARTICIPATION
  MATCH_WIN
  MATCH_MVP
  MATCH_BONUS
  PURCHASE
  ADMIN_ADJUST
  REFUND
  DAILY_BONUS // decision 014 §5
  VOICE_TIME // decision 014 §6
}

/// The ledger: append-only, one row per economic fact, `reference` makes it idempotent.
/// Reference formats (003 §3, 014 §1, §5, §6): match:<id>:participation:<userId>,
/// match:<id>:win:<userId>, match:<id>:mvp:<userId>, purchase:<purchaseId>:<period>,
/// refund:<purchaseId>, daily:<userId>:<moscowDay>, voice:<userId>:<moscowDay>:<hour>,
/// admin:<nonce>, dev:<nonce>.
/// Raw SQL: CHECK "KpTransaction_amount_nonzero" (amount <> 0).
model KpTransaction {
  id           Int      @id @default(autoincrement())
  userId       String
  amount       Int // signed
  balanceAfter Int
  kind         TxKind
  reference    String   @unique
  description  String
  matchId      Int?
  purchaseId   Int?
  actorId      String? // who caused it (admin, organiser), snowflake
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  user     User      @relation(fields: [userId], references: [id])
  match    Match?    @relation(fields: [matchId], references: [id])
  purchase Purchase? @relation(fields: [purchaseId], references: [id])

  @@index([userId, createdAt])
}

// ─── Shop ───────────────────────────────────────────────────────────────────

/// A good. `kind` is validated against the kind registry (src/modules/shop/kinds), `config`
/// by that kind's schema (014 §3) — deliberately not an enum. `validityDays` null = forever,
/// and such a good has no renewal (014 §1).
/// Raw SQL: CHECK "ShopGood_price_positive" (price > 0).
model ShopGood {
  id           Int      @id @default(autoincrement())
  slug         String   @unique
  name         String
  description  String
  price        Int
  kind         String
  config       Json
  validityDays Int? // null = forever (Q1 meanwhile)
  enabled      Boolean  @default(false)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  purchases Purchase[]
}

enum PurchaseStatus {
  ACTIVE
  EXPIRED
  REVOKED
  REFUNDED // apply failed for good, the money went back (decision 014 §2)
}

/// One row is one chain of grant periods: a renewal extends it (decision 014 §1, amends 003 §6).
/// Raw SQL: partial UNIQUE INDEX "Purchase_one_active_per_user_good"
///          ON (userId, goodId) WHERE status = 'ACTIVE' — a double click cannot buy twice.
/// Raw SQL: CHECK "Purchase_periods_positive" (periods >= 1).
model Purchase {
  id             Int            @id @default(autoincrement())
  userId         String
  goodId         Int
  /// The running total of every period paid.
  pricePaid      Int
  status         PurchaseStatus @default(ACTIVE)
  /// How many periods were paid; the renew button carries it as the expected value.
  periods        Int            @default(1)
  grantedAt      DateTime       @default(now()) @db.Timestamptz(3)
  expiresAt      DateTime?      @db.Timestamptz(3)
  appliedAt      DateTime?      @db.Timestamptz(3) // null = the Discord grant is not confirmed yet
  revokedAt      DateTime?      @db.Timestamptz(3)
  revokedById    String?
  /// The one warning a day before the end was claimed (sent or lost, never twice).
  warnedAt       DateTime?      @db.Timestamptz(3)
  /// A non-ACTIVE row whose Discord grant has been taken back.
  cleanedAt      DateTime?      @db.Timestamptz(3)
  /// The last Discord failure applying this grant; the first one goes to the log channel.
  lastApplyError String?

  user         User            @relation(fields: [userId], references: [id])
  good         ShopGood        @relation(fields: [goodId], references: [id])
  transactions KpTransaction[]
  clan         Clan?
  room         PersonalRoom?

  @@index([status, expiresAt])
}

/// A clan bought as a `clan_role` good (decision 014 §3.2): the buyer plus up to maxMembers.
/// Raw SQL: CHECK "Clan_memberCount_range" (memberCount BETWEEN 0 AND 25).
/// Raw SQL: partial UNIQUE INDEX "Clan_open_name_key" ON (lower(name)) WHERE closedAt IS NULL.
model Clan {
  id          Int       @id @default(autoincrement())
  purchaseId  Int       @unique
  ownerId     String
  name        String
  /// 0xRRGGBB from the good's palette, never typed by the player.
  color       Int
  roleId      String?
  memberCount Int       @default(0)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  /// Set when the purchase expires or is refunded; frees the name and the members.
  closedAt    DateTime? @db.Timestamptz(3)

  purchase Purchase     @relation(fields: [purchaseId], references: [id])
  members  ClanMember[]
}

/// One clan per person (Q15): `userId` is unique across all clans.
model ClanMember {
  id      Int      @id @default(autoincrement())
  clanId  Int
  userId  String   @unique
  addedAt DateTime @default(now()) @db.Timestamptz(3)

  clan Clan @relation(fields: [clanId], references: [id], onDelete: Cascade)

  @@unique([clanId, userId])
}

/// A voice channel bought as a `personal_room` good (decision 014 §3.3); controlled through the bot.
/// Raw SQL: CHECK "PersonalRoom_userLimit_range" (userLimit BETWEEN 0 AND 99),
///          CHECK "PersonalRoom_guestCount_range" (guestCount BETWEEN 0 AND 25).
model PersonalRoom {
  id         Int      @id @default(autoincrement())
  purchaseId Int      @unique
  ownerId    String
  channelId  String?
  name       String
  /// 0 = no limit.
  userLimit  Int      @default(0)
  locked     Boolean  @default(true)
  guestCount Int      @default(0)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  purchase Purchase    @relation(fields: [purchaseId], references: [id])
  guests   RoomGuest[]
}

model RoomGuest {
  id      Int      @id @default(autoincrement())
  roomId  Int
  userId  String
  addedAt DateTime @default(now()) @db.Timestamptz(3)

  room PersonalRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
}

// ─── Earnings ───────────────────────────────────────────────────────────────

/// Voice minutes of one player on one Moscow day (decision 014 §6); no session table.
/// Raw SQL: CHECK "VoiceDay_minutes_nonnegative" (minutes >= 0),
///          CHECK "VoiceDay_paidHours_nonnegative" (paidHours >= 0).
model VoiceDay {
  userId     String
  /// Moscow calendar day, YYYY-MM-DD (core/clock.ts moscowDay).
  day        String
  minutes    Int      @default(0)
  paidHours  Int      @default(0)
  /// The tick minute last credited; an overlapping tick of the same minute credits nothing.
  lastTickAt DateTime @db.Timestamptz(3)

  @@id([userId, day])
}

// ─── Settings ───────────────────────────────────────────────────────────────

/// Singleton row, id = 1.
/// Raw SQL: CHECK "GuildSettings_recruitTimeoutHours_nonnegative" (recruitTimeoutHours >= 0),
///          CHECK "GuildSettings_dailyBonusAmount_nonnegative", "GuildSettings_voiceKpPerHour_nonnegative",
///          "GuildSettings_voiceDailyCapKp_nonnegative" (each >= 0; decision 014 §8).
model GuildSettings {
  id                      Int      @id @default(1)
  logChannelId            String?
  panelChannelId          String?
  defaultRecruitChannelId String?
  defaultVoiceCategoryId  String?
  autoMoveToVoice         Boolean  @default(false)
  /// An unfilled recruitment is cancelled after this many hours; 0 = never (decision 009 §5).
  recruitTimeoutHours     Int      @default(3)
  /// KP of the daily bonus; 0 = off (decisions 013 §3, 014 §5).
  dailyBonusAmount        Int      @default(50)
  /// KP per full hour in voice, and the most voice time pays in one Moscow day (013 §4).
  voiceKpPerHour          Int      @default(10)
  voiceDailyCapKp         Int      @default(60)
  updatedAt               DateTime @default(now()) @updatedAt @db.Timestamptz(3)
}

/// What a Discord role may do. The guild owner and Discord Administrator hold every
/// capability implicitly (src/modules/permissions).
enum Capability {
  ACTIVITY_CREATE // create recruitments (Q5 meanwhile: organiser and above)
  MATCH_MANAGE_ANY // manage / finish / cancel any match, not only one's own
  ECONOMY_ADMIN // adjust balances, pay withheld rewards, view any history
  SHOP_MANAGE // create and edit goods
  SETTINGS_MANAGE // channels, categories, roles, reward amounts
}

model RoleCapability {
  id         Int        @id @default(autoincrement())
  roleId     String
  capability Capability

  @@unique([roleId, capability])
}

enum RewardEvent {
  PARTICIPATION
  WIN
  MVP
  DRAW
}

/// A rule for a specific game overrides the default rule (gameId null).
/// Raw SQL: partial UNIQUE INDEX "RewardRule_event_default_key" ON (event) WHERE gameId IS NULL
///          — Postgres treats NULLs as distinct, so @@unique alone allows two defaults.
/// Raw SQL: CHECK "RewardRule_amount_nonnegative" (amount >= 0) — a negative reward would
///          debit players through economy.move (decision 008 §11).
model RewardRule {
  id     Int         @id @default(autoincrement())
  event  RewardEvent
  gameId Int?
  amount Int

  // Cascade, not the default SetNull: a game's own rule must never turn into a second default.
  game Game? @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([event, gameId])
}

model Game {
  id              Int     @id @default(autoincrement())
  slug            String  @unique
  name            String
  emoji           String
  defaultTeamSize Int
  enabled         Boolean @default(true)

  rewardRules RewardRule[]
  matches     Match[]
}

// ─── Matches ────────────────────────────────────────────────────────────────

enum TeamMode {
  AUTO
  MANUAL
}

/// Decision 004 §1.
enum MatchStatus {
  RECRUITING
  TEAMS_PENDING
  IN_PROGRESS
  FINISHED
  CANCELLED
}

enum Winner {
  A
  B
  DRAW
}

enum Team {
  A
  B
}

/// A recruitment and its match are one entity (003 §8).
/// Raw SQL: CHECK "Match_teamSize_range" (teamSize BETWEEN 2 AND 10),
///          CHECK "Match_capacity_twice_teamSize" (capacity = 2 * teamSize),
///          CHECK "Match_participantCount_range" (participantCount BETWEEN 0 AND capacity).
model Match {
  id               Int         @id @default(autoincrement())
  gameId           Int
  title            String
  teamSize         Int
  capacity         Int
  teamMode         TeamMode
  status           MatchStatus @default(RECRUITING)
  version          Int         @default(0)
  syncedVersion    Int         @default(-1)
  participantCount Int         @default(0)
  createdById      String
  recruitChannelId String
  recruitMessageId String?
  voiceCategoryId  String
  voiceChannelAId  String?
  voiceChannelBId  String?
  rewards          Json // snapshot of the resolved amounts at creation (×2 when special)
  /// ⭐ special match: every reward doubled; toggled only while RECRUITING (decision 009 §1).
  special          Boolean     @default(false)
  /// The last status sync announced in the recruit channel; NULL after a reopen (008 §8).
  announcedStatus  MatchStatus?
  winner           Winner?
  mvpUserId        String? // null on a finished match = «без MVP» (decision 009 §3)
  createdAt        DateTime    @default(now()) @db.Timestamptz(3)
  closedAt         DateTime?   @db.Timestamptz(3)
  startedAt        DateTime?   @db.Timestamptz(3)
  endedAt          DateTime?   @db.Timestamptz(3)
  /// Who finished or cancelled; null on a CANCELLED match = closed by the recruit timeout (009 §5).
  endedById        String?

  game         Game            @relation(fields: [gameId], references: [id])
  participants Participant[]
  transactions KpTransaction[]

  @@index([status])
}

model Participant {
  id           Int       @id @default(autoincrement())
  matchId      Int
  userId       String
  team         Team?
  joinedAt     DateTime  @default(now()) @db.Timestamptz(3)
  leftServerAt DateTime? @db.Timestamptz(3)

  match Match @relation(fields: [matchId], references: [id])
  user  User  @relation(fields: [userId], references: [id])

  @@unique([matchId, userId])
  @@index([userId])
}
